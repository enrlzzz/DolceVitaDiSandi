# =========================================================================
# Dolce Vita Di Sandi — configuração do servidor (Apache / Hostinger)
# Este arquivo precisa ficar na RAIZ do public_html.
# Com o deploy via Git da Hostinger, ele chega aqui sozinho a cada push.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Rotas amigáveis
# O index.html mora em Client/Public/Src/Pages/, mas o visitante nunca
# precisa saber disso. As regras abaixo servem a home na raiz do domínio
# e dão URLs limpas para as páginas internas.
# -------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Força HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Remove o www (mantenha só um dos dois formatos para o SEO)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Home
    RewriteRule ^$ Client/Public/Src/Pages/index.html [L]

    # URLs limpas -> arquivos reais
    RewriteRule ^cardapio/?$              Client/Public/Src/Pages/cardapio.html [L]
    RewriteRule ^politica-de-privacidade/?$ Client/Public/Src/Pages/politica-de-privacidade.html [L]
    RewriteRule ^politica-de-reembolso/?$   Client/Public/Src/Pages/politica-de-reembolso.html [L]

    # Página não encontrada volta para a home (site de página única)
    ErrorDocument 404 /Client/Public/Src/Pages/index.html
</IfModule>

# -------------------------------------------------------------------------
# 2. Cabeçalhos de segurança
# -------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Impede que o navegador "adivinhe" o tipo do arquivo
    Header always set X-Content-Type-Options "nosniff"

    # Bloqueia o site de ser exibido dentro de um iframe de terceiros
    Header always set X-Frame-Options "SAMEORIGIN"

    # Não vaza a URL completa ao sair do site
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Recursos do navegador que o site não usa
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # HSTS: só ative depois de confirmar que o HTTPS está 100% funcionando
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Política de conteúdo: o site só carrega o que vem daqui e do Google Fonts
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://wa.me; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# -------------------------------------------------------------------------
# 3. Compressão
# -------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -------------------------------------------------------------------------
# 4. Cache do navegador
# Imagens otimizadas têm o tamanho no nome do arquivo, então podem ser
# guardadas por muito tempo sem risco de o visitante ver versão velha.
# -------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType application/pdf        "access plus 1 month"
    ExpiresByType text/css               "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# -------------------------------------------------------------------------
# 5. Tipos de arquivo e proteções
# -------------------------------------------------------------------------
AddType image/webp .webp
AddType image/avif .avif

# Não deixa ninguém listar o conteúdo das pastas
Options -Indexes

# Bloqueia acesso a arquivos internos do projeto
<FilesMatch "^(\.git|\.gitignore|README|.*\.md|.*\.py)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^(raw-photos|tools|docs)/ - [F,L]
</IfModule>
